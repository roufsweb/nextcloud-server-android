memory_limit=512M
upload_max_filesize=1024M
post_max_size=1024M
max_execution_time=3600
max_input_time=3600
max_file_uploads=100
date.timezone=UTC
output_buffering=0
sys_temp_dir="{{FILES_DIR}}/tmp"
upload_tmp_dir="{{FILES_DIR}}/tmp"
session.save_path="{{FILES_DIR}}/tmp"

extension_dir="{{NATIVE_LIB_DIR}}"
extension=libphp_gd.so

; Security and Vulnerability Hardening (PHP2Shell CVE-2026-109618 and CVE-2026-109619)
session.upload_progress.enabled=0
expose_php=Off
display_errors=Off
display_startup_errors=Off
log_errors=On
error_log="{{FILES_DIR}}/run/php_error.log"
allow_url_include=Off

; Session Security
session.cookie_httponly=1
session.use_strict_mode=1
session.cookie_samesite="Lax"

[curl]
curl.cainfo="{{FILES_DIR}}/conf/cacert.pem"

[opcache]
opcache.enable=1
opcache.enable_cli=1
opcache.memory_consumption=128
opcache.interned_strings_buffer=32
opcache.max_accelerated_files=10000
opcache.revalidate_freq=1
opcache.save_comments=1
opcache.lockfile_path="{{FILES_DIR}}/tmp"

auto_prepend_file="{{FILES_DIR}}/conf/bootstrap.php"

[openssl]
openssl.openssl_conf="{{FILES_DIR}}/conf/openssl.cnf"
openssl.cafile="{{FILES_DIR}}/conf/cacert.pem"
