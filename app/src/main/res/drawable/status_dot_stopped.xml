<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="12dp"
        android:height="12dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="@color/text_grey" />
            <solid android:color="#208C9199" />
        </shape>
    </item>
    <item
        android:width="5dp"
        android:height="5dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/text_grey" />
        </shape>
    </item>
</layer-list>
